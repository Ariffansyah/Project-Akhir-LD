{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dashboard Irigasi Cerdas",
  "version": "1.0.0",
  "identifier": "id.litdih.irigasi-cerdas",
  "build": {
    "frontendDist": "../dashboard"
  },
  "app": {
    "windows": [
      { "title": "Dashboard Irigasi Cerdas AIoT", "width": 1100, "height": 900, "minWidth": 380, "minHeight": 500 }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
